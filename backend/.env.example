GEMINI_API_KEY=your_gemini_api_key_here

# Direct PostgreSQL connection string
# Format: postgresql://user:password@host:5432/database_name
# Local:   postgresql://postgres:password@localhost:5432/vinland_learning
# Neon:    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/vinland_learning?sslmode=require
# Railway: postgresql://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/vinland_learning
